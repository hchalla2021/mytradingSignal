# ==================== MARKET POSITIONING INTELLIGENCE ====================
# Rolling history points for 5-min prediction (30 points Ã— 5s = ~2.5 min window)
POSITIONING_HISTORY_POINTS=30
# Minimum % change to classify direction (avoids noise)
POSITIONING_STRONG_THRESHOLD=70
POSITIONING_BUY_THRESHOLD=55
POSITIONING_OI_CHANGE_MIN_PCT=0.05
POSITIONING_VOL_CHANGE_MIN_PCT=0.03




# ==================== SMART AI ALGO AUTO-TRADE ====================
# LIVE mode places real Zerodha orders when signals match thresholds.
# Disabled: AQTE refuses live entries while this legacy live engine is active.
ALGO_AUTO_TRADE_ENABLED=false
ALGO_TRADE_QUANTITY=1
ALGO_MIN_TRADE_CONFIDENCE=55
ALGO_MIN_TRADE_STRENGTH=35
ALGO_TRADE_COOLDOWN_SEC=90
ALGO_LIVE_EXCHANGE=NFO
ALGO_LIVE_SYMBOL_NIFTY=NIFTY26JUNFUT
ALGO_LIVE_SYMBOL_BANKNIFTY=BANKNIFTY26JUNFUT
ALGO_LIVE_SYMBOL_SENSEX=SENSEX26JUNFUT

# Prefer IPv4 for outbound broker API calls (Zerodha IP whitelist).
FORCE_OUTBOUND_IPV4=true

# ==================== AQTE LIVE (one-lot, default-OFF switch) ====================
# Orders are sent only from the host whose outbound IPv4 equals AQTE_LIVE_STATIC_IP
# (DigitalOcean droplet). Register the same IP in the Kite developer console.
AQTE_LIVE_ENABLED=true
EXPIRYEDGE_AI_LIVE_ENABLED=true
AQTE_LIVE_DEPLOYMENT_MODE=local
AQTE_LIVE_LOCAL_STATIC_IP=122.177.241.72
#AQTE_LIVE_PRODUCTION_STATIC_IP=159.65.147.167
# Resolved from the two values above by AQTE_LIVE_DEPLOYMENT_MODE.
#AQTE_LIVE_STATIC_IP=122.177.241.68
# Rule-based entries (quick scalp / fully aligned swing) may place real orders where AQTE_LIVE_ENABLED=true
AQTE_LIVE_ALLOW_UNVALIDATED_RULES=true
AQTE_LIVE_RISK_PER_TRADE=1000
AQTE_LIVE_DAILY_LOSS=2000
AQTE_LIVE_MAX_TRADES=5
AQTE_LIVE_MAX_LOSSES=3
# Quick scalp premium-point targets per index (stop = target x ratio); bad entries disable that index
AQTE_SCALP_POINTS=NIFTY:10/20/30,BANKNIFTY:20/40/60,SENSEX:30/60/90
AQTE_SCALP_STOP_RATIO=0.4

